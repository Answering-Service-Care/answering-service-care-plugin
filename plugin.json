{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "answering-service-care",
  "version": "1.0.0",
  "description": "Your Answering Service Care messages, follow-up To Dos, on-call schedules and how contacts are reached, with your own Client Portal login.",
  "author": {
    "name": "Answering Service Care",
    "url": "https://answeringservicecare.com/"
  },
  "homepage": "https://answeringservicecare.com/",
  "repository": "https://github.com/Answering-Service-Care/answering-service-care-plugin",
  "license": "MIT",
  "keywords": [
    "answering-service",
    "customer-portal",
    "messages",
    "on-call",
    "mcp",
    "customer-service"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/setup/SKILL.md",
      "interface": {
        "displayName": "Answering Service Care",
        "shortDescription": "Messages and on-call coverage",
        "longDescription": "Connect your Answering Service Care account with your own Client Portal login to review messages, set up follow-up To Dos, see and change who's on call, and update how your contacts receive messages.",
        "developerName": "Answering Service Care",
        "logo": "./assets/logo.png",
        "composerIcon": "./assets/logo.png",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "websiteURL": "https://answeringservicecare.com/",
        "supportURL": "https://answeringservicecare.com/contact-us/",
        "privacyPolicyURL": "https://answeringservicecare.com/privacy-policy/",
        "termsOfServiceURL": "https://answeringservicecare.com/terms-and-conditions/",
        "defaultPrompt": [
          "Show me the messages I need to follow up on today.",
          "Who is on call for my line tonight?",
          "Which To Dos are still open on my account?"
        ]
      }
    }
  }
}
